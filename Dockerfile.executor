ARG PYTHON_VERSION="3.12"
ARG CONDA_PYTHON_VERSION="3.12"
ARG MICROMAMBA_VERSION="2.3.3"
FROM mambaorg/micromamba:${MICROMAMBA_VERSION} AS micromamba

FROM python:${PYTHON_VERSION}-slim-bookworm AS base

WORKDIR /opt
ARG CONDA_PYTHON_VERSION="3.12"
ARG POETRY_VERSION="2.4.1"
ARG GDAL_VERSION="3.13.1"

ENV POETRY_VIRTUALENVS_IN_PROJECT=1
ENV POETRY_HOME=/opt/poetry
ENV VIRTUAL_ENV=/opt/openeo_argoworkflows_executor/.venv
ENV CONDA_PREFIX=${VIRTUAL_ENV}
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV LD_LIBRARY_PATH=${VIRTUAL_ENV}/lib
ENV GDAL_DATA=${VIRTUAL_ENV}/share/gdal
ENV PROJ_DATA=${VIRTUAL_ENV}/share/proj

COPY --from=micromamba /usr/bin/micromamba /usr/local/bin/micromamba

COPY ./openeo_argoworkflows/executor/README.md ./openeo_argoworkflows/executor/pyproject.toml ./openeo_argoworkflows/executor/poetry.lock /opt/

RUN micromamba create -y -p $VIRTUAL_ENV --override-channels -c conda-forge \
        "python=${CONDA_PYTHON_VERSION}" \
        "gdal=${GDAL_VERSION}" \
        pip && \
    micromamba clean -a -y && \
    $VIRTUAL_ENV/bin/pip install -U pip setuptools && \
    $VIRTUAL_ENV/bin/pip install poetry==${POETRY_VERSION} poetry-plugin-export

ENV PATH="${POETRY_HOME}/bin:${VIRTUAL_ENV}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends g++ git && rm -rf /var/lib/apt/lists/* && \
    git config --global url."https://github.com/".insteadOf "git@github.com:"

# Export dependencies from poetry lock and install via pip. Only gdal is
# excluded: it comes from conda-forge above, and letting pip install the PyPI
# bindings would replace the library they were built against.
#
# Everything else, including the direct Git dependencies, comes straight from
# the lock at its resolved commit. Do NOT reintroduce a --no-deps install at a
# hardcoded tag here: that bypasses the lock, so pyproject and the image can
# silently disagree about which revision ships (they did -- pyproject said
# dev.2 while the image installed dev.5).
RUN poetry export --only main --without-hashes -o /tmp/requirements.txt && \
    grep -v "^gdal==" /tmp/requirements.txt > /tmp/requirements-no-gdal.txt && \
    $VIRTUAL_ENV/bin/pip install --no-cache-dir -r /tmp/requirements-no-gdal.txt && \
    rm /tmp/requirements.txt /tmp/requirements-no-gdal.txt

# Create the openeo_executor CLI entry point script directly.
# Avoids pip install . which triggers poetry-core's path validation bug
# ("'/usr/local/bin/python3.11' is not in the subpath of '/opt'").
RUN printf '#!/opt/openeo_argoworkflows_executor/.venv/bin/python\nfrom openeo_argoworkflows_executor.cli import cli\ncli()\n' > $VIRTUAL_ENV/bin/openeo_executor && \
    chmod +x $VIRTUAL_ENV/bin/openeo_executor

# Install Calrissian without its dependency pins so it cannot downgrade the
# Zarr v3 executor stack through typing-extensions==4.8.0. The pyproject pins
# the rest of Calrissian's dependency list to the exact versions it asks for,
# so --no-deps leaves a consistent environment.
RUN $VIRTUAL_ENV/bin/pip install --no-deps calrissian==0.18.1

# typing-extensions is the one Calrissian pin we cannot honour: it wants
# ==4.8.0, zarr 3 needs >=4.12. Relax that single requirement in Calrissian's
# installed metadata.
#
# This matters because calrissian/version.py does:
#
#     try:
#         pkg = pkg_resources.require(package_name)
#     except pkg_resources.DistributionNotFound:
#
# It catches DistributionNotFound but NOT VersionConflict. Any version mismatch
# in its declared requirements therefore escapes package_version(), propagates
# out of calrissian.main (which we call in-process from run_cwl), and fails the
# job with "Calrissian execution error". A missing distribution is survivable;
# a mismatched one is not.
# The dist-info is located through importlib.metadata rather than a glob:
# $VIRTUAL_ENV/lib/ contains both python3.12 and a python3.1 symlink, so a
# glob matches twice and yields a malformed path.
RUN cd / && $VIRTUAL_ENV/bin/python -c "\
import importlib.metadata as md, pathlib; \
p = pathlib.Path(str(md.distribution('calrissian')._path)) / 'METADATA'; \
s = p.read_text(); \
old = 'Requires-Dist: typing-extensions==4.8.0'; \
new = 'Requires-Dist: typing-extensions>=4.8.0'; \
assert old in s, 'calrissian no longer pins typing-extensions==4.8.0 - drop this patch'; \
p.write_text(s.replace(old, new)); \
print('relaxed:', new)"

# Verify the entry point exists
RUN which openeo_executor

# Guard the Calrissian version lookup described above. Run from / so the
# package directory is not on sys.path. This fails the build on any
# VersionConflict between Calrissian's declared pins and what is installed,
# rather than letting the first CWL job discover it.
RUN cd / && $VIRTUAL_ENV/bin/python -c "\
from calrissian.version import version; \
print('calrissian version lookup OK:', version())"

########################################################################################################################
FROM python:${PYTHON_VERSION}-slim-bookworm AS prod

ARG USER_ID=1000
ARG GROUP_ID=1000

WORKDIR /opt/openeo_argoworkflows_executor

COPY --from=base --chown=${USER_ID}:${GROUP_ID} /opt/openeo_argoworkflows_executor/.venv /opt/openeo_argoworkflows_executor/.venv
COPY --chown=${USER_ID}:${GROUP_ID} ./openeo_argoworkflows/executor/openeo_argoworkflows_executor /opt/openeo_argoworkflows_executor

RUN apt-get update && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} -o executor \
    && useradd -m -u ${USER_ID} -g ${GROUP_ID} -o -s /bin/bash executor

ENV VIRTUAL_ENV=/opt/openeo_argoworkflows_executor/.venv
ENV CONDA_PREFIX=${VIRTUAL_ENV}
ENV LD_LIBRARY_PATH=${VIRTUAL_ENV}/lib
ENV GDAL_DATA=${VIRTUAL_ENV}/share/gdal
ENV PROJ_DATA=${VIRTUAL_ENV}/share/proj
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV DASK_GATEWAY_SERVER="http://traefik-openeo-dask-gateway.openeo.svc.cluster.local:80"
ENV PYTHONPATH="/opt"

# Calrissian inspects containers[0] for PVC mounts. In Argo Workflow pods,
# containers[0] is the 'wait' sidecar which mounts the workspace PVC at
# /mainctrfs/user_workspaces, while the 'main' executor container mounts
# at /user_workspaces. This symlink bridges the gap so Calrissian's
# expected paths resolve correctly.
RUN mkdir -p /mainctrfs && ln -s /user_workspaces /mainctrfs/user_workspaces

# Distributed 2026.x dropped standalone dask-scheduler/dask-worker entry
# points in favour of "dask scheduler" / "dask worker" subcommands, but
# Dask Gateway still hardcodes the legacy names for scheduler/worker pods.
# Create wrapper scripts to bridge the gap.
RUN printf '#!/bin/bash\nexec dask scheduler "$@"\n' > $VIRTUAL_ENV/bin/dask-scheduler && \
    printf '#!/bin/bash\nexec dask worker "$@"\n' > $VIRTUAL_ENV/bin/dask-worker && \
    chmod +x $VIRTUAL_ENV/bin/dask-scheduler $VIRTUAL_ENV/bin/dask-worker

USER ${USER_ID}

CMD ["openeo_executor"]
